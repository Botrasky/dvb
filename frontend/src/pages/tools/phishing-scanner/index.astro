---
import SiteLayout from '../../../layouts/SiteLayout.astro';
export const prerender = true;
---

<SiteLayout title="ZEUS | Phishing Scanner" current="scanner">
  <main id="main" class="scanner">
    <header class="scanner-head"><div><p class="eyebrow">◈ ZEUS Security Scanner</p><h1>Phishing URL scanner</h1><p>Inspect the URL locally, then cross-check an existing VirusTotal report.</p></div><span class="preview-badge">Beta</span></header>
    <form id="scan-form" class="analysis-card">
      <p class="card-kicker">URL ANALYSIS</p>
      <label for="scan-input">URL or domain</label>
      <div class="row"><input id="scan-input" type="text" maxlength="8192" autocomplete="off" spellcheck="false" required placeholder="example.com" /><button>Scan URL</button></div>
      <p>When the scheme is missing, HTTPS is suggested for parsing; it is not verified.</p>
      <p class="sharing-note"><strong>Before you scan:</strong> submitting sends this URL to VirusTotal for a first-stage reputation cross-check. VirusTotal may retain or share queried URLs. Do not submit private, sensitive, or personal URLs. ZEUS does not visit or save the destination.</p>
    </form>
    <div class="row"><button id="rescan" type="button">Rescan URL</button><button id="clear" type="button">New scan</button><button id="demo" type="button">Try example</button></div>
    <p id="scan-status" role="status" aria-live="polite">Beta scanner ready.</p>
    <section id="scan-results" hidden aria-label="Scan results">
      <header class="report-heading">
        <h2>Scan report</h2>
        <p id="domain"></p>
        <p id="redacted"></p>
      </header>
      <nav class="report-nav" aria-label="Jump to report section">
        <a href="#overview">Overview</a>
        <a href="#findings">Findings</a>
        <a href="#technical">Technical</a>
        <a href="#reports">Export</a>
      </nav>
      <div id="overview" class="report-section">
        <h2>Overview</h2>
        <div id="verdict-card" class="verdict-card" hidden aria-live="polite">
          <span class="card-kicker">VirusTotal verdict</span>
          <h3 id="verdict-title">Checking VirusTotal evidence…</h3>
          <p id="verdict-summary"></p>
          <span id="verdict-source" class="verdict-source"></span>
        </div>
        <div id="reputation-results" class="provider-evidence" hidden>
          <h3>VirusTotal cross-check</h3>
          <p id="vt-summary"></p>
          <ul id="vt-details"></ul>
          <p>Missing or zero detections in the existing report do not prove a URL is safe.</p>
        </div>
        <div class="summary-grid">
          <div class="summary-card"><span>Local risk score</span><strong id="score-value">N/A</strong><span id="score-state">Partial analysis</span></div>
          <div class="summary-card"><span>Local checks completed</span><strong id="coverage-count"></strong><div class="progress-track"><span id="coverage-progress"></span></div></div>
        </div>
        <p>A low or unavailable score does not establish that a website is safe.</p>
      </div>
      <div id="findings" class="report-section">
        <h2>Findings</h2>
        <div id="finding-list"></div>
      </div>
      <div id="technical" class="report-section">
        <h2>Technical details</h2>
        <h3>Check coverage</h3>
        <ul id="coverage-list"></ul>
        <h3>Limitations</h3>
        <ul id="limitations"></ul>
        <p id="versions"></p>
        <details class="console-card"><summary>Analysis console</summary><ol id="console"></ol></details>
      </div>
      <footer id="reports" class="report-section">
        <h2>Export report</h2>
        <p>Reports contain redacted results. Inspect before sharing.</p>
        <div class="row"><button id="copy" type="button">Copy results</button><button id="json" type="button">Download JSON</button></div>
        <p id="report-status" role="status"></p>
      </footer>
    </section>
    <aside><h2>Privacy</h2><p>Local URL analysis runs in this browser. Submitting also shares the URL with VirusTotal, which may retain or share it under its terms. ZEUS does not fetch the destination or save scan history.</p></aside>
  </main>
</SiteLayout>

<script>
  import { scanUrl } from '../../../lib/scanner/engine.ts';
  import type { ScanResult } from '../../../lib/scanner/types.ts';
  const el = (id: string) => document.getElementById(id)!;
  const input = el('scan-input') as HTMLInputElement;
  const form = el('scan-form') as HTMLFormElement;
  const submitButton = form.querySelector('button') as HTMLButtonElement;
  let result: ScanResult | null = null;
  function reveal(element: Element) {
    if (document.documentElement.classList.contains('site-motion-off') || (matchMedia('(prefers-reduced-motion: reduce)').matches && !document.documentElement.classList.contains('site-motion-on'))) return;
    element.getAnimations().forEach((animation) => animation.cancel());
    element.animate([{ opacity: .55, translate: '5px 0' }, { opacity: 1, translate: '0 0' }],
      { duration: 250, easing: 'ease-out' });
  }
  function revealSection(section: HTMLElement) {
    const motionOverride = document.documentElement.classList.contains('site-motion-on');
    if ((matchMedia('(prefers-reduced-motion: reduce)').matches && !motionOverride) || document.documentElement.classList.contains('site-motion-off')) return;
    const groups = Array.from(section.children).filter((child) => !(child as HTMLElement).hidden);
    groups.forEach((group, index) => {
      group.getAnimations().forEach((animation) => animation.cancel());
      group.animate(
        [{ opacity: 0, transform: `translateX(${index % 2 ? 64 : -64}px)` }, { opacity: 1, transform: 'translateX(0)' }],
        { duration: 880, delay: Math.min(index, 5) * 85, easing: 'cubic-bezier(.2,.76,.26,1)', fill: 'backwards' },
      );
    });
  }
  type ReputationResult = {
    provider: 'VirusTotal';
    status: 'found' | 'not_found' | 'unavailable';
    checkedAt?: string;
    lastAnalysisDate?: string | null;
    stats?: { malicious: number; suspicious: number; harmless: number; undetected: number; timeout: number; total: number };
    reason?: 'not_configured' | 'network_error' | 'rate_limited' | 'provider_error' | 'invalid_response';
    evidence?: { engines: { engine: string; category: string; result: string | null }[] };
  };
  type ProviderPayload = { virusTotal: ReputationResult; verdict?: { level: 'known_threat' | 'suspicious' | 'no_known_threat_found' | 'inconclusive'; reason: string } };
  let reputation: ReputationResult | null = null;
  let activeLookup: AbortController | null = null;
  let scanSequence = 0;
  const set = (id: string, value: string) => { el(id).textContent = value; };
  const items = (id: string, values: string[]) => el(id).replaceChildren(...values.map((value) => { const li = document.createElement('li'); li.textContent = value; return li; }));
  const checkNames: Record<string, string> = {
    'brand-impersonation': 'Brand impersonation',
    'suspicious-characters': 'Suspicious characters',
    'ip-and-port': 'IP address and port',
    'shortener': 'URL shortener',
    'https-and-credentials': 'HTTPS and credentials',
    'phishing-keywords': 'Phishing keywords',
  };
  function readProviderPayload(value: unknown): ProviderPayload | null {
    if (!value || typeof value !== 'object') return null;
    const data = value as Record<string, unknown>;
    if (data.provider !== 'VirusTotal' || !['found', 'not_found', 'unavailable'].includes(String(data.status))) return null;
    const names = ['malicious', 'suspicious', 'harmless', 'undetected', 'timeout', 'total'] as const;
    const stats = data.stats as Record<string, unknown> | undefined;
    if (data.status === 'found' && (!stats || names.some((name) => !Number.isSafeInteger(stats[name]) || Number(stats[name]) < 0))) return null;
    const virusTotal: ReputationResult = data.status === 'found' ? { provider: 'VirusTotal', status: 'found', lastAnalysisDate: typeof data.lastAnalysisDate === 'string' ? data.lastAnalysisDate : null, stats: Object.fromEntries(names.map((name) => [name, Number(stats![name])])) as ReputationResult['stats'], evidence: data.evidence as ReputationResult['evidence'] } : data.status === 'not_found' ? { provider: 'VirusTotal', status: 'not_found' } : { provider: 'VirusTotal', status: 'unavailable', reason: 'provider_error' };
    return { virusTotal, verdict: data.verdict as ProviderPayload['verdict'] };
  }
  function renderProviders(payload: ProviderPayload | null) {
    if (!payload) { el('reputation-results').hidden = true; el('verdict-card').hidden = true; return; }
    const value = payload.virusTotal;
    reputation = value;
    el('reputation-results').hidden = false;
    if (value.status === 'found' && value.stats) {
      set('vt-summary', `${value.stats.malicious} malicious and ${value.stats.suspicious} suspicious detections across ${value.stats.total} engines.`);
      const detail = [`Harmless: ${value.stats.harmless}`, `Undetected: ${value.stats.undetected}`, `Timeout: ${value.stats.timeout}`];
      if (value.lastAnalysisDate) detail.push(`Report date: ${value.lastAnalysisDate}`);
      items('vt-details', detail);
    } else if (value.status === 'not_found') {
      set('vt-summary', 'No existing VirusTotal report. ZEUS did not submit a new scan.');
      items('vt-details', []);
    } else {
      const message = value.reason === 'not_configured' ? 'VirusTotal is not configured on the server.' : 'VirusTotal did not return a report.';
      set('vt-summary', message);
      items('vt-details', []);
    }
    const labels = { known_threat: ['Known threat', 'VirusTotal reports multiple malicious detections. Treat this URL as risky.'], suspicious: ['Suspicious', 'VirusTotal reports some malicious or suspicious detections. Use caution.'], no_known_threat_found: ['No known threat found', 'The last VirusTotal report has no detections. This does not guarantee safety.'], inconclusive: ['Inconclusive', 'VirusTotal has no report or could not complete the check.'] } as const;
    const level = payload.verdict?.level ?? 'inconclusive';
    const [title, summary] = labels[level];
    el('verdict-card').dataset.level = level;
    set('verdict-title', title); set('verdict-summary', summary); set('verdict-source', `Decision: ${payload.verdict?.reason?.replaceAll('_', ' ') || 'provider coverage'}`); el('verdict-card').hidden = false;
    reveal(el('verdict-card'));
  }
  async function checkReputation(rawUrl: string, sequence: number) {
    activeLookup?.abort();
    const controller = new AbortController();
    activeLookup = controller;
    submitButton.disabled = true;
    form.setAttribute('aria-busy', 'true');
    set('vt-summary', 'Checking provider evidence…');
    items('vt-details', []);
    el('reputation-results').hidden = false;
    try {
      const response = await fetch('/api/phishing-check/', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ url: rawUrl, consent: true }),
        signal: controller.signal,
      });
      const payload: unknown = await response.json();
      if (sequence !== scanSequence) return;
      const parsed = readProviderPayload(payload);
      if (!response.ok || !parsed) throw new Error('Provider response unavailable');
      renderProviders(parsed);
      set('scan-status', 'Local analysis and VirusTotal cross-check complete.');
    } catch {
      if (controller.signal.aborted || sequence !== scanSequence) return;
      renderProviders({ virusTotal: { provider: 'VirusTotal', status: 'unavailable', reason: 'network_error' }, verdict: { level: 'inconclusive', reason: 'network_error' } });
      set('scan-status', 'Local analysis complete; VirusTotal could not be reached.');
    } finally {
      if (sequence === scanSequence) { submitButton.disabled = false; form.removeAttribute('aria-busy'); }
    }
  }
  const reportSections = document.querySelectorAll<HTMLElement>('.report-section');
  document.querySelectorAll<HTMLAnchorElement>('.report-nav a').forEach((link) => {
    link.addEventListener('click', () => {
      const section = document.querySelector<HTMLElement>(link.hash);
      if (section) revealSection(section);
    });
  });
  const observer = 'IntersectionObserver' in window ? new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        revealSection(entry.target as HTMLElement);
        observer?.unobserve(entry.target);
      }
    }
  }) : null;
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const sequence = ++scanSequence;
    activeLookup?.abort();
    submitButton.disabled = false;
    form.removeAttribute('aria-busy');
    renderProviders(null);
    try {
      result = scanUrl(input.value);
      el('scan-results').hidden = false;
      set('domain', `Registrable domain: ${result.registrableDomain ?? 'unavailable'}`);
      set('redacted', `Redacted URL: ${result.redactedDisplayUrl}`);
      const completed = result.coverage.filter((c) => c.status === 'completed').length;
      set('coverage-count', `${completed} of ${result.coverage.length} categories`);
      (el('coverage-progress') as HTMLElement).style.width = `${Math.round((completed / result.coverage.length) * 100)}%`;
      set('score-value', result.score === null ? 'N/A' : String(result.score));
      set('score-state', result.score === null ? 'Partial analysis' : result.label);
      el('finding-list').replaceChildren(...result.findings.map((finding) => {
        const article = document.createElement('article');
        const heading = document.createElement('h3');
        heading.textContent = `${checkNames[finding.category] ?? finding.category} · ${finding.severity}`;
        const body = document.createElement('p');
        body.textContent = `${finding.explanation} ${finding.recommendation}`;
        article.append(heading, body);
        return article;
      }));
      if (!result.findings.length) set('finding-list', 'No suspicious URL patterns identified in completed checks.');
      el('coverage-list').replaceChildren(...result.coverage.map((check) => {
        const row = document.createElement('li');
        const name = document.createElement('span');
        const status = document.createElement('strong');
        name.textContent = checkNames[check.id] ?? check.id;
        status.textContent = check.status;
        row.append(name, status);
        return row;
      }));
      set('versions', `Engine ${result.engineVersion} · scoring ${result.scoringVersion} · rules ${result.rulesVersion}`);
      items('limitations', result.limitations);
      items('console', ['✓ URL parsed locally', ...result.coverage.map((c) => `${c.status === 'completed' ? '✓' : '!'} ${c.id}: ${c.status}`), result.isPartial ? '! Partial analysis; score unavailable' : '✓ Analysis complete']);
      set('scan-status', 'Local analysis complete; checking provider evidence.');
      reportSections.forEach((section) => observer?.observe(section));
      void checkReputation(input.value, sequence);
    } catch {
      result = null;
      renderProviders(null);
      el('scan-results').hidden = true;
      set('scan-status', 'Enter a valid HTTP(S) URL or domain.');
    }
  });
  el('rescan').addEventListener('click', () => form.requestSubmit());
  el('clear').addEventListener('click', () => { scanSequence++; activeLookup?.abort(); submitButton.disabled = false; form.removeAttribute('aria-busy'); input.value = ''; result = null; renderProviders(null); el('scan-results').hidden = true; set('scan-status', 'Ready for a new scan.'); input.focus(); });
  el('demo').addEventListener('click', () => { input.value = 'example.com.attacker.test'; form.requestSubmit(); });
  el('copy').addEventListener('click', async () => { if (!result) return; try { await navigator.clipboard.writeText(JSON.stringify({ localAnalysis: result, reputation }, null, 2)); set('report-status', 'Redacted result copied.'); } catch { set('report-status', 'Copy failed. Check clipboard permission.'); } });
  el('json').addEventListener('click', () => { if (!result) return; const url = URL.createObjectURL(new Blob([JSON.stringify({ localAnalysis: result, reputation }, null, 2)], { type: 'application/json' })); const link = document.createElement('a'); link.href = url; link.download = 'zeus-redacted-scan.json'; link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000); set('report-status', 'Redacted JSON downloaded.'); });
</script>

<style>
  .scanner {
    --surface: rgba(15, 25, 42, .68); --raised: rgba(20, 38, 55, .72); --line: rgba(139, 241, 208, .22);
    --ink: #eef5fc; --muted: #b2c3d3; --accent: #78d4f0;
    --accent-ink: #092637; --notice: rgba(29, 62, 74, .64);
    max-width: 1080px; margin: auto; padding: 4rem 1.25rem 6rem;
    display: grid; gap: 1rem; color: var(--ink);
  }
  :global(html.light-mode) .scanner {
    --surface: rgba(255, 255, 255, .78); --raised: rgba(245, 250, 253, .80); --line: rgba(255, 255, 255, .55);
    --ink: #172f40; --muted: #354b5a; --accent: #126b8c;
    --accent-ink: #ffffff; --notice: #e4f0f5;
  }
  :global(html.light-mode) .scanner { position: relative; isolation: isolate; }
  :global(html.light-mode) .scanner::before {
    content: ''; position: absolute; z-index: -1; inset: 0 calc(50% - 50vw);
    background: radial-gradient(ellipse 48% 42% at 0% 25%, rgba(41, 208, 235, .4), transparent 75%),
      radial-gradient(ellipse 48% 42% at 100% 55%, rgba(143, 113, 244, .34), transparent 75%), #253447;
    pointer-events: none;
  }
  :global(html.light-mode) .scanner-head h1 { color: #f4f9ff; }
  :global(html.light-mode) .scanner-head p, :global(html.light-mode) .scanner #scan-status { color: #d8e9f3; }
  :global(html.light-mode) .scanner .preview-badge { color: #edf7fc; border-color: rgba(255, 255, 255, .5); }
  :global(html.light-mode) .scanner form,
  :global(html.light-mode) .scanner section:not(#scan-results),
  :global(html.light-mode) .scanner aside,
  :global(html.light-mode) .coverage-card {
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 16px 40px rgba(8, 21, 36, .19), inset 0 1px rgba(255, 255, 255, .8);
  }
  .scanner-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: 0 0 1.25rem; }
  .scanner-head > div { max-width: 720px; }
  .scanner h1 { font-size: clamp(2.3rem, 5vw, 4rem); line-height: 1.08; letter-spacing: -.04em; margin: .45rem 0 .8rem; color: var(--ink); }
  .scanner h2 { font-size: 1.2rem; letter-spacing: -.015em; margin: 0 0 .8rem; color: var(--ink); }
  .scanner p { line-height: 1.65; }
  .scanner-head p, .scanner aside, .scanner form > p:not(.card-kicker) { color: var(--muted); }
  .eyebrow, .card-kicker { font-size: .78rem; font-weight: 700; letter-spacing: .05em; color: var(--accent); }
  .preview-badge { border: 1px solid var(--line); color: var(--muted); border-radius: 999px; padding: .4rem .8rem; font-size: .8rem; font-weight: 700; }
  .scanner form, .scanner section, .scanner aside, .coverage-card { border: 1px solid var(--line); border-radius: 1rem; padding: 1.5rem; background: var(--surface); }
  :global(html:not(.light-mode)) .scanner form,
  :global(html:not(.light-mode)) .scanner section:not(#scan-results),
  :global(html:not(.light-mode)) .scanner aside,
  :global(html:not(.light-mode)) .coverage-card {
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 16px 40px -8px rgba(0, 0, 0, .32), inset 0 1px rgba(255, 255, 255, .06);
  }
  .scanner .analysis-card { padding: clamp(1.5rem, 3vw, 2.25rem); background: var(--raised); }
  .analysis-card label { display: block; font-weight: 700; margin: 1.25rem 0 .6rem; }
  .scanner .row { display: flex; flex-wrap: wrap; gap: .65rem; }
  .scanner input { flex: 1 1 18rem; min-width: 0; background: var(--surface); color: var(--ink); font: inherit; font-size: 1.1rem; padding: .95rem 1rem; border: 1px solid var(--line); border-radius: .55rem; }
  .scanner input::placeholder { color: var(--muted); opacity: 1; }
  .scanner button { padding: .75rem 1rem; border: 1px solid var(--line); border-radius: .55rem; background: var(--surface); color: var(--ink); font: inherit; font-weight: 600; cursor: pointer; }
  .scanner form button { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); padding-inline: 1.5rem; }
  .scanner button:hover { border-color: var(--accent); }
  .scanner button:disabled { cursor: wait; opacity: .65; }
  .scanner button:focus-visible, .scanner input:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .scanner .sharing-note { border-left: 3px solid var(--accent); padding: .85rem 1rem; background: var(--notice); border-radius: 0 .4rem .4rem 0; color: var(--ink) !important; margin-bottom: 0; }
  .scanner #scan-status { color: var(--muted); margin: .25rem 0; }
  .scanner #scan-results { display: block; padding: 0; background: var(--surface); }
  #scan-results > * { padding: clamp(1rem, 3vw, 2rem); }
  #scan-results > * + * { border-top: 1px solid var(--line); }
  .report-heading h2 { font-size: 1.75rem; }
  .report-heading p { margin: .25rem 0; }
  #scan-results .report-nav { display: flex; gap: .4rem 1.4rem; flex-wrap: wrap; padding-block: .7rem; }
  .report-nav a { color: var(--accent); text-decoration: underline; text-underline-offset: .22em; padding-block: .35rem; }
  .report-section { scroll-margin-top: 1rem; }
  .report-section h3 { font-size: 1rem; margin: 1rem 0 .35rem; }
  .report-section .verdict-card { padding: 1rem; border: 1px solid var(--verdict-color); border-radius: .6rem; }
  .report-section .verdict-card h3 { font-size: 1.4rem; margin-top: .35rem; }
  .report-section .summary-grid { margin-top: 1rem; }
  .report-section .summary-card { padding: .7rem 0; }
  .report-section .summary-card strong { font-size: 1.5rem; }
  #reputation-results { margin-top: 1rem; padding-top: .5rem; border-top: 1px solid var(--line); }
  .console-card summary { cursor: pointer; font-weight: 600; padding-block: .65rem; }
  .scanner [hidden], .scanner #scan-results[hidden] { display: none; }
  .coverage-card { background: var(--raised); }
  .coverage-card > div:first-child { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  .progress-track { height: .5rem; margin-top: 1rem; background: var(--line); border-radius: 99px; overflow: hidden; }
  .progress-track span { display: block; height: 100%; width: 0; background: var(--accent); transition: width .7s ease; }
  .scanner .verdict-card { --verdict-color: #78d4f0; --verdict-bg: rgba(19, 72, 102, .78); background: var(--verdict-bg); border-color: var(--verdict-color); border-left-width: 4px; }
  .scanner .verdict-card[data-level="known_threat"], .scanner .verdict-card[data-level="suspicious"] { --verdict-color: #ff9a9a; --verdict-bg: rgba(113, 27, 40, .88); }
  .scanner .verdict-card[data-level="no_known_threat_found"] { --verdict-color: #a0e5be; --verdict-bg: rgba(23, 83, 60, .88); }
  .scanner .verdict-card .card-kicker { color: var(--verdict-color); }
  :global(html.light-mode) .scanner .verdict-card { --verdict-color: #135d82; --verdict-bg: #e2f3fa; }
  :global(html.light-mode) .scanner .verdict-card[data-level="known_threat"], :global(html.light-mode) .scanner .verdict-card[data-level="suspicious"] { --verdict-color: #a01f30; --verdict-bg: #ffebed; }
  :global(html.light-mode) .scanner .verdict-card[data-level="no_known_threat_found"] { --verdict-color: #17683d; --verdict-bg: #e3f5e9; }
  .verdict-card h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); margin: .5rem 0; }
  .verdict-card p { max-width: 58ch; color: var(--muted); }
  .verdict-source { color: var(--muted); font-size: .85rem; text-transform: capitalize; }
  .summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; align-items: stretch; }
  .evidence-grid { display: grid; gap: .75rem; }
  .summary-card { display: grid; gap: .4rem; align-content: start; }
  .summary-card strong { font-size: clamp(1.7rem, 3vw, 2.5rem); line-height: 1.15; color: var(--ink); }
  .summary-card > span:last-child { color: var(--muted); }
  .scanner #redacted { overflow-wrap: anywhere; }
  .evidence-block { border: 1px solid var(--line); border-radius: .65rem; padding: 1rem; background: var(--raised); }
  .evidence-block h3 { margin: 0 0 .5rem; color: var(--ink); font-size: 1rem; }
  .scanner section p, .scanner aside p { max-width: 72ch; }
  .scanner section p:last-child, .scanner aside p:last-child { margin-bottom: 0; }
