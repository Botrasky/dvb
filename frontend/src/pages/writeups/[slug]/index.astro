---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { readLegacyPage, writeupSlugs } from '../../../lib/legacy-page';
import '../../../../css/writeup-story.css';
import '../../../../writeups/writeups.css';

export const prerender = true;

export async function getStaticPaths() {
  const reports = await getCollection('writeups');
  const slugs = new Set([
    ...writeupSlugs(),
    ...reports.map(report => report.data.slug),
  ]);

  return [...slugs].map(slug => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const reports = await getCollection('writeups');
const report = reports.find(entry => entry.data.slug === slug);
const practiceSources = {
  'CyLab Security Academy': { name: 'CyLab Security Academy', url: 'https://learn.cylabacademy.org/' },
  'OffSec Proving Grounds': { name: 'OffSec Proving Grounds', url: 'https://portal.offsec.com/' },
};
const practiceSource = report?.data.platform === 'VMware Local Lab'
  ? { name: 'your local VMware lab', url: null }
  : practiceSources[report?.data.platform as keyof typeof practiceSources];
const topicNames = { crypto: 'cryptography', pwn: 'binary exploitation', web: 'web security', re: 'reverse engineering', general: 'security', misc: 'security' };
const practiceTopic = report ? topicNames[report.data.topic] : 'security';
const page = readLegacyPage(`writeups/${slug}/index.html`)
  .replace('<head>', `<head><base href="/writeups/${slug}/">`)
  .replace('src="../writeups.js?', 'src="/writeups/writeups.js?');
const legacyStyles = [...page.matchAll(/<style(?:\s[^>]*)?>([\s\S]*?)<\/style>/gi)]
  .map(match => `<style>${match[1]}</style>`)
  .join('');
const legacyMain = (page.match(/<main\b[\s\S]*?<\/main>/i)?.[0] || '')
  .replace('<main id="main-content"', '<main id="main"')
  .replace('href="../../index.html" class="wu-back"', 'href="/writeups/" class="wu-back"');
---

<SiteLayout title={`${report?.data.title ?? slug} — Writeup — Dos Vathanak Botra`} description={report?.data.summary} current="writeups" headHtml={legacyStyles}>
  <Fragment set:html={legacyMain} />
  {practiceSource && (
    <section class="dash-shell writeup-native-shell" aria-labelledby="practice-next">
      <div class="panel writeup-native">
        <h2 id="practice-next">Practice next</h2>
        <p>Explore more {practiceTopic} challenges {practiceSource.url ? 'on' : 'in'} {practiceSource.name}.</p>
        {practiceSource.url && <a class="dash-button secondary" href={practiceSource.url} target="_blank" rel="noopener noreferrer" data-analytics-event="practice_next_click" data-analytics-label={slug} data-analytics-topic={practiceTopic}>Explore {practiceSource.name} ↗</a>}
      </div>
    </section>
  )}
  <script is:inline src="/writeups/writeups.js"></script>
  <script is:inline src="/js/site.js"></script>
</SiteLayout>
