---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { readLegacyPage, writeupSlugs } from '../../../lib/legacy-page';

export const prerender = true;

export function getStaticPaths() {
  return writeupSlugs().map(slug => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const reportIds: Record<string, string> = {
  'creds-surf': 'creds-surf_report',
  'hidden-cipher-2': 'hidden-cipher-2_report',
  moneybox: 'moneybox_report',
  'pizza-router': 'pizza-router_report',
  'printer-shares-3': 'printer-shares-3_report',
  'secure-pass-db': 'secure-pass-db_report',
  'trust-but-verify': 'trust-but-verify_report',
  'ven-rsa': 'ven-rsa_report',
};
const reports = await getCollection('writeups');
const report = reports.find(entry => entry.id === reportIds[slug]);
const Content = report ? (await render(report)).Content : undefined;
const page = report ? '' : readLegacyPage(`writeups/${slug}/index.html`);
---

{report && Content ? (
  <SiteLayout title={`${slug} | ZEUS`} current="writeups">
    <main id="main" class="dash-shell writeup-native-shell">
      <article class="writeup-native panel"><Content /></article>
    </main>
  </SiteLayout>
) : <Fragment set:html={page} />}
