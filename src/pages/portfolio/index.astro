<script>
  const words = ['security operations', 'hands-on research', 'building useful tools'];
  const typed = document.getElementById('portfolio-typed');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const motionEnabled = () => (window as Window & { siteMotion?: { enabled: () => boolean } }).siteMotion?.enabled() ?? !reduce.matches;
  if (typed) {
    let word = 0, character = words[0].length, deleting = false, timer: ReturnType<typeof setTimeout>;
    const tick = () => {
      if (document.hidden || !motionEnabled()) return;
      const text = words[word];
      typed.textContent = text.slice(0, character);
      if (!deleting && character === text.length) { deleting = true; timer = setTimeout(tick, 2000); return; }
      if (deleting && character === 0) { deleting = false; word = (word + 1) % words.length; timer = setTimeout(tick, 350); return; }
      character += deleting ? -1 : 1;
      timer = setTimeout(tick, deleting ? 45 : 80);
    };
    const resetTyping = () => { clearTimeout(timer); word = 0; character = words[0].length; deleting = false; typed.textContent = words[0]; if (motionEnabled() && !document.hidden) timer = setTimeout(tick, 1600); };
    resetTyping();
    document.addEventListener('visibilitychange', () => { clearTimeout(timer); if (!document.hidden && motionEnabled()) { typed.textContent = words[word]; character = words[word].length; deleting = true; timer = setTimeout(tick, 1800); } });
    reduce.addEventListener('change', resetTyping);
  }

  const slides = [...document.querySelectorAll<HTMLElement>('.certificate-slide')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('.certificate-dots button')];
  const viewer = document.querySelector<HTMLElement>('.certificate-viewer');
  let active = 0, interval: ReturnType<typeof setInterval>;
  function showSlide(index: number) {
    if (!slides.length) return;
    active = (index + slides.length) % slides.length;
    slides.forEach((slide, i) => { slide.hidden = i !== active; slide.setAttribute('aria-hidden', String(i !== active)); });
    dots.forEach((dot, i) => { dot.classList.toggle('is-active', i === active); if (i === active) dot.setAttribute('aria-current', 'true'); else dot.removeAttribute('aria-current'); });
  }
  function pauseSlides() { clearInterval(interval); }
  function playSlides() { pauseSlides(); if (motionEnabled() && !document.hidden) interval = setInterval(() => showSlide(active + 1), 4000); }
  document.getElementById('certificate-prev')?.addEventListener('click', () => { showSlide(active - 1); playSlides(); });
  document.getElementById('certificate-next')?.addEventListener('click', () => { showSlide(active + 1); playSlides(); });
  dots.forEach((dot, index) => dot.addEventListener('click', () => { showSlide(index); playSlides(); }));
  viewer?.addEventListener('focusin', pauseSlides);
  viewer?.addEventListener('focusout', () => { if (!viewer.contains(document.activeElement)) playSlides(); });
  viewer?.addEventListener('mouseenter', pauseSlides);
  viewer?.addEventListener('mouseleave', playSlides);
  document.addEventListener('visibilitychange', () => document.hidden ? pauseSlides() : playSlides());
  reduce.addEventListener('change', playSlides);
  let startX = 0;
  viewer?.addEventListener('touchstart', event => { startX = event.touches[0].clientX; }, { passive: true });
  viewer?.addEventListener('touchend', event => { const delta = startX - event.changedTouches[0].clientX; if (Math.abs(delta) > 45) { showSlide(active + (delta > 0 ? 1 : -1)); playSlides(); } }, { passive: true });
  playSlides();
</script>

